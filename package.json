{
  "name": "visionpower",
  "version": "2.5.0",
  "description": "VisionPower: a portable image understanding MCP server for Codex, Claude Desktop, Cursor, and other agents.",
  "type": "module",
  "bin": {
    "visionpower": "src/index.js"
  },
  "files": [
    "src",
    "VisionPower-Skill",
    "docs/images",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "build:skill": "node scripts/build-skill.mjs --write",
    "dev:webui": "node src/index.js --webui",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "skill",
    "agent-skill",
    "vision",
    "ocr",
    "image-understanding",
    "codex",
    "claude"
  ],
  "author": "Runhua",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "alpinejs": "^3.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "globals": "^17.9.0"
  }
}
